# Optional external JEV-style decision layer for /smart-task's triage step.
# Leave everything unset to use the built-in self-classification (Claude on haiku) — no setup required.

# Option A: point at a running OpenJev server (https://github.com/SiliconLabAI/OpenJev)
# OPENJEV_URL=http://localhost:3001

# Option B: call Groq directly (https://console.groq.com/keys), used only if OPENJEV_URL is unset
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
